<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Sharing Application</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>File Sharing Application</h1>
    <div class="center-container">
        <h3>This file is protected. Enter password to download.</h3>
        <% if (error) { %>
            <p class="error-text">Wrong password</p>
        <% } %>
        <form class="password-form" action="/file/<%= fileId %>" method="POST">
            <input type="password" name="password" required>
            <br />
            <button type="submit">Download</button>
        </form>
    </div>
</body>
</html>
